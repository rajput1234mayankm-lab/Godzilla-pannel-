window.CFGate = {
    isWorking: false,
    isDone: false,

    init: function() {
        // Fast-path: Check if already verified in session or cookie
        var hasCookie = document.cookie.indexOf('God Zilla _cf_verified=1') !== -1;
        var hasStorage = false;
        try {
            hasStorage = (sessionStorage.getItem('God Zilla _cf_verified') === '1');
        } catch(e) {}

        if (hasCookie || hasStorage) {
            this.dismissImmediate();
            return;
        }

        // Prevent background scrolling while challenge is active
        document.body.style.overflow = 'hidden';
    },

    handleClick: function(e) {
        if (this.isWorking || this.isDone) return;
        this.isWorking = true;

        var box = document.getElementById('cf-turnstile-box');
        var label = document.getElementById('cf-status-label');

        if (box) box.classList.add('verifying');
        if (label) label.textContent = 'Verifying...';

        // Check for basic headless automation markers
        var isAutomation = navigator.webdriver || false;
        var verifyDelay = isAutomation ? 2500 : 1200;

        var self = this;
        setTimeout(function() {
            self.completeSuccess();
        }, verifyDelay);
    },

    onOfficialSuccess: function(token) {
        this.completeSuccess();
    },

    completeSuccess: function() {
        this.isWorking = false;
        this.isDone = true;

        var box = document.getElementById('cf-turnstile-box');
        var label = document.getElementById('cf-status-label');

        if (box) {
            box.classList.remove('verifying');
            box.classList.add('verified');
        }
        if (label) label.textContent = 'Verification successful';

        // Store verification in cookie and session
        try {
            sessionStorage.setItem('God Zilla _cf_verified', '1');
        } catch(e) {}
        document.cookie = "God Zilla _cf_verified=1; path=/; max-age=43200; SameSite=Lax";

        // Inform backend asynchronously
        try {
            fetch('api/verify_human.php', { method: 'POST' }).catch(function(){});
        } catch(e) {}

        // Dismiss gate smoothly after 400ms
        var self = this;
        setTimeout(function() {
            self.dismissSmooth();
        }, 400);
    },

    dismissSmooth: function() {
        var wrap = document.getElementById('cf-turnstile-wrapper');
        if (wrap) {
            wrap.style.opacity = '0';
            wrap.style.transform = 'scale(1.02)';
            setTimeout(function() {
                wrap.classList.add('cf-verified-hide');
                wrap.style.display = 'none';
                document.body.style.overflow = '';
                self.startVideo();
            }, 380);
        } else {
            document.body.style.overflow = '';
            this.startVideo();
        }
    },

    dismissImmediate: function() {
        var wrap = document.getElementById('cf-turnstile-wrapper');
        if (wrap) {
            wrap.classList.add('cf-verified-hide');
            wrap.style.display = 'none';
        }
        document.body.style.overflow = '';
        this.startVideo();
    },

    startVideo: function() {
        var vid = document.getElementById('cinematic-bg-video');
        if (vid && vid.paused) {
            vid.play().catch(function(){});
        }
    }
};

// Immediate invocation
